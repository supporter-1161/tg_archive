<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Поиск — {{ query }}</title>
<link rel="stylesheet" href="/static/css/style.css">
</head>
<body data-theme="{{ default_theme | default('light') }}">
<header class="header">
    <div class="header-title-desc">
        <h1><a href="/index.html">{{ site_title | default('Архив Telegram') }}</a></h1>
        <p>{{ site_description | default('') }}</p>
    </div>
</header>

<form class="search-box" action="/search" method="get">
    <input type="text" name="q" class="search-input" value="{{ query }}" placeholder="Поиск по архиву..." autocomplete="off" required>
    <button type="submit" class="search-button">Найти</button>
</form>

<main class="results">
{% if error %}
<div class="no-results"><p>{{ error }}</p></div>
{% elif not query %}
<div class="no-results"><p>Введите запрос для поиска по архиву.</p></div>
{% elif total == 0 %}
<div class="no-results">
<p>По запросу «<strong>{{ query }}</strong>» ничего не найдено.</p>
</div>
{% else %}
<p class="results-count">
Найдено: <strong>{{ total }}</strong>{% if total_pages > 1 %} · страница {{ page }} из {{ total_pages }}{% endif %}
</p>
{% for item in results %}
<div class="result-item">
<a class="result-title" href="/{{ item.relative_url }}">{{ item.title }}</a>
<div class="result-snippet">{{ item.snippet | safe }}</div>
</div>
{% endfor %}

{% if total_pages > 1 %}
<div class="pagination">
{% if page > 1 %}
<a href="?q={{ query | urlencode }}&amp;page={{ page - 1 }}">&laquo; Назад</a>
{% endif %}
{% for num in range(1, total_pages + 1) %}
{% if num == page %}
<span class="current">{{ num }}</span>
{% else %}
<a href="?q={{ query | urlencode }}&amp;page={{ num }}">{{ num }}</a>
{% endif %}
{% endfor %}
{% if page < total_pages %}
<a href="?q={{ query | urlencode }}&amp;page={{ page + 1 }}">Вперёд &raquo;</a>
{% endif %}
</div>
{% endif %}
{% endif %}
</main>

<footer class="footer">
<p>{{ site_title | default('Архив Telegram') }}{% if footer_text %} | {{ footer_text }}{% endif %}</p>
</footer>
</body>
</html>
