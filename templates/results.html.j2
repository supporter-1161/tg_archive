<!-- templates/results.html.j2 -->
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Поиск — {{ query }}</title>
<link rel="stylesheet" href="static/css/style.css">
<style>
/* Дополнительные стили для поиска */
.search-form {
margin: 1rem 0;
display: flex;
gap: 0.5rem;
}
.search-form input {
flex: 1;
padding: 0.5rem;
border: 1px solid var(--border-color);
border-radius: 4px;
background-color: var(--bg-color);
color: var(--text-color);
}
.search-form button {
padding: 0.5rem 1rem;
background-color: var(--accent-color);
color: white;
border: none;
border-radius: 4px;
cursor: pointer;
}
.search-form button:hover {
opacity: 0.9;
}
.result-item {
margin: 1rem 0;
padding: 1rem;
border-left: 3px solid var(--accent-color);
background-color: var(--bg-color);
}
.result-title {
display: block;
font-weight: bold;
color: var(--accent-color);
text-decoration: none;
margin-bottom: 0.5rem;
}
.result-title:hover {
text-decoration: underline;
}
.result-snippet {
color: var(--text-color);
opacity: 0.9;
}
.no-results {
text-align: center;
padding: 2rem;
color: gray;
}
</style>
</head>
<body data-theme="{{ default_theme | default('light') }}">
<header class="header">
<div class="header-title-desc">
<h1>{{ site_title | default('Архив Telegram') }}</h1>
<p>{{ site_description | default('Результаты поиска') }}</p>
</div>
<div class="controls">
<span class="theme-toggle" onclick="toggleTheme()">☀️/🌙</span>
</div>
</header>

<div style="padding: 0 1rem; max-width: 900px; margin: 0 auto;">
<form class="search-form" action="/search" method="get">
<input type="text" name="q" value="{{ query }}" placeholder="Поиск по архиву..." required>
<button type="submit">Найти</button>
</form>

{% if total == 0 %}
<div class="no-results">
<p>По запросу «<strong>{{ query }}</strong>» ничего не найдено.</p>
</div>
{% else %}
<p style="margin: 1rem 0;">Найдено: <strong>{{ total }}</strong> результатов</p>
{% for item in results %}
<div class="result-item">
<a class="result-title" href="/{{ item.relative_url }}">{{ item.title }}</a>
<div class="result-snippet">{{ item.content | truncate(250) }}</div>
</div>
{% endfor %}
{% endif %}
</div>

<script>
function toggleTheme() {
const body = document.body;
const currentTheme = body.getAttribute('data-theme');
const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
body.setAttribute('data-theme', newTheme);
}
</script>
</body>
</html>
