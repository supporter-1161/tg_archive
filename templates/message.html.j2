<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Сообщение #{{ message.id }} - {{ site_title }}</title>
<link rel="stylesheet" href="../static/css/style.css?v={{ generation_run_number }}">
<link rel="stylesheet" href="../static/css/topic.css?v={{ generation_run_number }}">
</head>
<body data-theme="{{ default_theme }}">
<header class="header">
    {% if banner %}
    <div class="header-banner"><img src="{{ banner.url }}" alt="{{ banner.alt }}"></div>
    {% endif %}
    <div class="header-row">
        <div class="header-title-desc">
            <h1>{{ site_title }}</h1>
            <p>{{ site_description }}</p>
        </div>
        <form class="search-box" action="{{ config.get('search', {}).get('url', '/search') }}" method="get">
            <input type="text" name="q" class="search-input" placeholder="Поиск по архиву..." autocomplete="off" required>
            <button type="submit" class="search-button">Найти</button>
        </form>
    </div>
</header>

{% if ticker_enabled %}
<div class="ticker">
<div class="ticker-content">
{% for text in ticker_texts %}
<span class="ticker-item">{{ text }}</span>
&nbsp; &nbsp; &nbsp;
{% endfor %}
</div>
</div>
{% endif %}

<div class="main-content">
<aside class="sidebar">
<div class="sidebar-section">
<h3>Все Темы</h3>
<ul class="topic-list">
{% for topic in topics %}
<li>
<a class="{% if topic.id == current_topic.id %}active{% endif %}" href="/topics/topic_{{ topic.id }}_page_1.html">
{{ topic.icon_emoji | default('') }} {{ topic.title }}
<span class="count">({{ topic.message_count }})</span>
</a>
</li>
{% endfor %}
</ul>
</div>
<div class="sidebar-section">
<h3>{{ config.get('ui', {}).get('useful_links_title', 'Полезные ссылки') }}</h3>
<ul class="useful-links">
{% for link in useful_links %}
<li>
<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
{{ link.icon | default('🔗') }} {{ link.name }}
{% if link.description %}<br><small>{{ link.description }}</small>{% endif %}
</a>
</li>
{% endfor %}
</ul>
</div>
</aside>
<main class="content">
<div class="breadcrumb">
<a href="../index.html">Главная</a> &raquo;
<a href="../topics/topic_{{ current_topic.id }}_page_1.html">{{ current_topic.title }}</a> &raquo;
Сообщение #{{ message.id }}
</div>
<div class="topic-header">
<h2>{{ current_topic.icon_emoji | default('') }} {{ current_topic.title }}</h2>
</div>
<div class="info-panel">
<p>Сообщение #{{ message.id }} | Отправлено: {{ message.timestamp }}</p>
{% if message.reply_to_msg_id %}
<p>Ответ на сообщение: <a href="message_{{ message.reply_to_msg_id }}.html">#{{ message.reply_to_msg_id }}</a></p>
{% endif %}
</div>
<div class="message-card layout-{{ message_layout }}">
<div class="message-header">
{% if message.author_avatar_path and message.author_avatar_path.startswith('avatars/') %}
<img src="../{{ message.author_avatar_path }}" alt="Avatar" class="message-author-icon">
{% elif default_avatar %}
<img src="../{{ default_avatar }}" alt="Default Avatar" class="message-author-icon">
{% else %}
<div class="message-author-icon">👤</div>
{% endif %}
<span class="message-author-name">
{{ message.author_first_name }}{% if message.author_last_name %} {{ message.author_last_name }}{% endif %}{% if message.author_username %} (@{{ message.author_username }}){% endif %}
</span>
<span class="message-timestamp">{{ message.timestamp }}</span>
</div>
<div class="message-body">
<div class="message-main">
{% if message.media_skipped_size_human %}
<div class="media-skipped">
Вложение не сохранено — {{ message.media_skipped_size_human }}{% if message.file_extension %} ({{ message.file_extension | upper }}){% endif %}: превышает лимит архива.
</div>
{% endif %}
{% if message.text %}
<div class="message-text">{{ message.text | safe }}</div>
{% endif %}
</div>
{% if album_messages | length > 1 %}
<div class="album-media">
{% if album_messages | selectattr('media_thumbnail_path') | list %}
<div class="album-grid">
{% for m in album_messages if m.media_type == 'photo' and m.media_thumbnail_path %}
<figure class="album-item">
<a href="../{{ m.media_original_path }}" target="_blank">
<img src="../{{ m.media_thumbnail_path }}" alt="Фото" loading="lazy">
</a>
<figcaption>{% if m.thumb_size_human %}{{ m.thumb_size_human }}{% endif %}{% if m.thumb_size_human and m.file_size_human %} → {% endif %}{% if m.file_size_human %}{{ m.file_size_human }}{% endif %}</figcaption>
</figure>
{% endfor %}
</div>
{% endif %}
{% for m in album_messages if m.media_type == 'video' and m.media_original_path %}
<div class="album-video">
<video controls preload="none"><source src="../{{ m.media_original_path }}" type="video/mp4">Видео не поддерживается.</video>
<div class="file-size">{% if m.file_size_human %}видео {{ m.file_size_human }}{% endif %}</div>
</div>
{% endfor %}
{% for m in album_messages if m.media_type not in ('photo', 'video') and m.media_original_path %}
<div class="album-item album-file">
<a href="../{{ m.media_original_path }}" target="_blank" download>Файл: {{ m.media_original_path.split('/')[-1] }}{% if m.file_extension %} ({{ m.file_extension | upper }}){% endif %}</a>
{% if m.file_size_human %}<figcaption>{{ m.file_size_human }}</figcaption>{% endif %}
</div>
{% endfor %}
</div>
{% elif message.media_thumbnail_path or (message.media_original_path and message.media_type != 'photo') %}
<div class="message-media">
{% if message.media_type == 'photo' %}
<a class="media-photo" href="../{{ message.media_original_path }}" target="_blank">
<img src="../{{ message.media_thumbnail_path }}" alt="Фото" loading="lazy">
</a>
{% elif message.media_type == 'video' %}
<video controls preload="none"><source src="../{{ message.media_original_path }}" type="video/mp4">Видео не поддерживается.</video>
{% else %}
<a href="../{{ message.media_original_path }}" target="_blank" download>
Файл: {{ message.media_original_path.split('/')[-1] }}{% if message.file_extension %} ({{ message.file_extension | upper }}){% endif %}
</a>
{% endif %}
<div class="file-size">{% if message.thumb_size_human %}превью {{ message.thumb_size_human }}{% endif %}{% if message.thumb_size_human and message.file_size_human %} · {% endif %}{% if message.file_size_human %}оригинал {{ message.file_size_human }}{% endif %}</div>
</div>
{% endif %}
</div>
</div>
<p class="back-link"><a href="../topics/topic_{{ current_topic.id }}_page_1.html#m{{ message.id }}">&larr; Вернуться к теме</a></p>
</main>
</div>
<footer class="footer">
<p class="footer-line">{{ site_title }}{% if show_update_time %} · обновлено {{ generation_date }} UTC{% endif %} · сообщений: {{ current_topic.total_messages }}{% if footer_text %} · {{ footer_text }}{% endif %}</p>
</footer>
</body>
</html>
