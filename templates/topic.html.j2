<!-- templates/topic.html.j2 -->
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ current_topic.title }} - {{ site_title }}</title>
    <link rel="stylesheet" href="../static/css/style.css">
    <link rel="stylesheet" href="../static/css/topic.css">
</head>
<body data-theme="{{ default_theme }}">
    <header class="header">
        <div class="header-title-desc">
            <h1>{{ site_title }}</h1>
            <p>{{ site_description }}</p>
        </div>
        <div class="controls">
            <span class="theme-toggle" onclick="toggleTheme()">☀️/🌙</span>
        </div>
    </header>
    {% if ticker_enabled %}
    <div class="ticker">
        <div class="ticker-content">
            {% for text in ticker_texts %}
                <span class="ticker-item">{{ text }}</span>
                &nbsp; &nbsp; &nbsp;
            {% endfor %}
        </div>
    </div>
    {% endif %}
    <div class="main-content">
        <aside class="sidebar">
            <div class="sidebar-section">
                <h3>Все Темы</h3>
                <ul class="topic-list">
                    {% for topic in topics %}
                    <li>
                        <a href="{% if topic.id == current_topic.id %}#{% else %}../topics/topic_{{ topic.id }}_page_1.html{% endif %}">
                            {{ topic.icon_emoji | default('') }} {{ topic.title }}
                            <span style="font-size: 0.8em; color: gray;">({{ topic.message_count }})</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="sidebar-section">
                <h3>Полезные ссылки</h3>
                <ul class="useful-links">
                    {% for link in useful_links %}
                    <li>
                        <a href="{{ link.url }}" target="_blank">
                            {{ link.icon | default('🔗') }} {{ link.name }}
                            {% if link.description %}<br><small>{{ link.description }}</small>{% endif %}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </aside>
        <main class="content">
            <div class="breadcrumb">
                <a href="../index.html">Главная</a> &raquo; {{ current_topic.title }}
            </div>
            <div class="topic-header">
                <h2>{{ current_topic.icon_emoji | default('') }} {{ current_topic.title }}</h2>
            </div>
            <div class="info-panel">
                <p>Всего сообщений: {{ current_topic.total_messages }} | Первое сообщение: {{ current_topic.first_message_time }} | Последнее: {{ current_topic.last_message_time }}</p>
            </div>
            <div class="order-label">
                Показ: {% if show_order_label %}от новых к старым{% else %}от старых к новым{% endif %}
            </div>
            <!-- Верхняя пагинация -->
            {% if total_pages > 1 and config.ui.get('show_top_pagination', false) %}
            <div class="pagination top-pagination">
                {% if current_page > 1 %}
                    <a href="topic_{{ current_topic.id }}_page_{{ current_page - 1 }}.html">&laquo; Назад</a>
                {% endif %}
                {% for page_num in page_links %}
                    {% if page_num == current_page %}
                        <span class="current">{{ page_num }}</span>
                    {% else %}
                        <a href="topic_{{ current_topic.id }}_page_{{ page_num }}.html">{{ page_num }}</a>
                    {% endif %}
                {% endfor %}
                {% if current_page < total_pages %}
                    <a href="topic_{{ current_topic.id }}_page_{{ current_page + 1 }}.html">Вперёд &raquo;</a>
                {% endif %}
            </div>
            {% endif %}
            <div class="messages-list">
                {% for message in messages %}
                <div class="message-card">
                    <div class="message-header">
                        <a href="../messages/message_{{ message.id }}.html" style="text-decoration: none; color: gray; margin-right: 0.5rem;">#{{ message.id }}</a>
                        {% if message.author_avatar_path and message.author_avatar_path.startswith('avatars/') %}
                            <img src="../{{ message.author_avatar_path }}" alt="Avatar" class="message-author-icon">
                        {% else %}
                            {% set default_avatar = config.get('ui', {}).get('default_avatar_path', '') %}
                            {% if default_avatar %}
                                <img src="../{{ default_avatar }}" alt="Default Avatar" class="message-author-icon">
                            {% else %}
                                <div class="message-author-icon">👤</div>
                            {% endif %}
                        {% endif %}
                        <span class="message-author-name">
                            {{ message.author_first_name }}{% if message.author_last_name %} {{ message.author_last_name }}{% endif %}{% if message.author_username %} (@{{ message.author_username }}){% endif %}
                        </span>
                        <span class="message-timestamp">{{ message.timestamp }}</span>
                    </div>
                    {% if message.media_thumbnail_path or (message.media_original_path and message.media_type != 'photo') %}
                        <div class="message-media">
                            {% if message.file_size_bytes %}
                                <div class="file-size" style="color: gray; font-size: 0.8em;">
                                    <script>
                                        function humanReadableSize(bytes) {
                                            if (bytes === 0) return '0 B';
                                            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
                                            const i = parseInt(Math.floor(Math.log(bytes) / Math.log(1024)));
                                            if (i === 0) return bytes + ' ' + sizes[i];
                                            return (bytes / Math.pow(1024, i)).toFixed(2) + ' ' + sizes[i];
                                        }
                                        document.write(humanReadableSize({{ message.file_size_bytes }}));
                                    </script>
                                </div>
                            {% endif %}
                            {% if message.media_type == 'photo' %}
                                <a href="../{{ message.media_original_path }}" target="_blank">
                                    <img src="../{{ message.media_thumbnail_path }}" alt="Photo">
                                </a>
                            {% elif message.media_type == 'video' %}
                                <video controls><source src="../{{ message.media_original_path }}" type="video/mp4">Видео не поддерживается.</video>
                            {% elif message.media_type in ('document', 'audio') %}
                                <a href="../{{ message.media_original_path }}" target="_blank" download>
                                    Файл: {{ message.media_original_path.split('/')[-1] }} ({{ message.file_extension | upper }})
                                </a>
                            {% else %}
                                <a href="../{{ message.media_original_path }}" target="_blank" download>
                                    Файл: {{ message.media_original_path.split('/')[-1] }}
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                    {% if message.text %}
                        <div class="message-text">{{ message.text | safe }}</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            <!-- Нижняя пагинация -->
            {% if total_pages > 1 %}
            <div class="pagination">
                {% if current_page > 1 %}
                    <a href="topic_{{ current_topic.id }}_page_{{ current_page - 1 }}.html">&laquo; Назад</a>
                {% endif %}
                {% for page_num in page_links %}
                    {% if page_num == current_page %}
                        <span class="current">{{ page_num }}</span>
                    {% else %}
                        <a href="topic_{{ current_topic.id }}_page_{{ page_num }}.html">{{ page_num }}</a>
                    {% endif %}
                {% endfor %}
                {% if current_page < total_pages %}
                    <a href="topic_{{ current_topic.id }}_page_{{ current_page + 1 }}.html">Вперёд &raquo;</a>
                {% endif %}
            </div>
            {% endif %}
        </main>
    </div>
    <footer class="footer">
        <p>{{ site_title }} | Обновлено: {{ generation_date }} | Запуск #{{ generation_run_number }} | Сообщений: {{ current_topic.total_messages }}</p>
        <p>{{ footer_text }}</p>
    </footer>
    <script>
        function toggleTheme() {
            const body = document.body;
            const currentTheme = body.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            body.setAttribute('data-theme', newTheme);
        }
    </script>
</body>
</html>
