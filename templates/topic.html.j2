<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ current_topic.title }} - {{ site_title }}</title>
<link rel="stylesheet" href="../static/css/style.css?v={{ generation_run_number }}">
<link rel="stylesheet" href="../static/css/topic.css?v={{ generation_run_number }}">
</head>
<body data-theme="{{ default_theme }}">

{% macro card_header(m, config, default_avatar) %}
<div class="message-header">
{% if config.ui.get('generate_message_pages', True) %}
<a class="message-id" href="../messages/message_{{ m.id }}.html">#{{ m.id }}</a>
{% else %}
<span class="message-id">#{{ m.id }}</span>
{% endif %}
{% if m.reply_to_msg_id %}
<a class="message-reply" href="../messages/message_{{ m.reply_to_msg_id }}.html">ответ на #{{ m.reply_to_msg_id }}</a>
{% endif %}
{% if m.author_avatar_path and m.author_avatar_path.startswith('avatars/') %}
<img src="../{{ m.author_avatar_path }}" alt="Avatar" class="message-author-icon">
{% elif default_avatar %}
<img src="../{{ default_avatar }}" alt="Default Avatar" class="message-author-icon">
{% else %}
<div class="message-author-icon">👤</div>
{% endif %}
<span class="message-author-name">{{ m.author_first_name }}{% if m.author_last_name %} {{ m.author_last_name }}{% endif %}{% if m.author_username %} (@{{ m.author_username }}){% endif %}</span>
<span class="message-timestamp">{{ m.timestamp }}</span>
</div>
{% endmacro %}

{% macro album_media(m) %}
{% if m.media_type == 'photo' and m.media_thumbnail_path %}
<figure class="album-item">
<a href="../{{ m.media_original_path }}" target="_blank">
<img src="../{{ m.media_thumbnail_path }}" alt="Фото" loading="lazy">
</a>
<figcaption>{% if m.thumb_size_human %}{{ m.thumb_size_human }}{% endif %}{% if m.thumb_size_human and m.file_size_human %} → {% endif %}{% if m.file_size_human %}{{ m.file_size_human }}{% endif %}</figcaption>
</figure>
{% elif m.media_original_path %}
<div class="album-item album-file">
<a href="../{{ m.media_original_path }}" target="_blank" download>Файл: {{ m.media_original_path.split('/')[-1] }}{% if m.file_extension %} ({{ m.file_extension | upper }}){% endif %}</a>
{% if m.file_size_human %}<figcaption>{{ m.file_size_human }}</figcaption>{% endif %}
</div>
{% endif %}
{% endmacro %}

<header class="header">
    {% if banner %}
    <div class="header-banner"><img src="{{ banner.url }}" alt="{{ banner.alt }}"></div>
    {% endif %}
    <div class="header-row">
        <div class="header-title-desc">
            <h1>{{ site_title }}</h1>
            <p>{{ site_description }}</p>
        </div>
        <form class="search-box" action="{{ config.get('search', {}).get('url', '/search') }}" method="get">
            <input type="text" name="q" class="search-input" placeholder="Поиск по архиву..." autocomplete="off" required>
            <button type="submit" class="search-button">Найти</button>
        </form>
    </div>
</header>

{% if ticker_enabled %}
<div class="ticker">
<div class="ticker-content">
{% for text in ticker_texts %}
<span class="ticker-item">{{ text }}</span>
&nbsp; &nbsp; &nbsp;
{% endfor %}
</div>
</div>
{% endif %}

<div class="main-content">
<aside class="sidebar">
<div class="sidebar-section">
<h3>Все Темы</h3>
<ul class="topic-list">
{% for topic in topics %}
<li>
<a class="{% if topic.id == current_topic.id %}active{% endif %}" href="{% if topic.id == current_topic.id %}#{% else %}/topics/topic_{{ topic.id }}_page_1.html{% endif %}">
{{ topic.icon_emoji | default('') }} {{ topic.title }}
<span class="count">({{ topic.message_count }})</span>
</a>
</li>
{% endfor %}
</ul>
</div>
<div class="sidebar-section">
<h3>{{ config.get('ui', {}).get('useful_links_title', 'Полезные ссылки') }}</h3>
<ul class="useful-links">
{% for link in useful_links %}
<li>
<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
{{ link.icon | default('🔗') }} {{ link.name }}
{% if link.description %}<br><small>{{ link.description }}</small>{% endif %}
</a>
</li>
{% endfor %}
</ul>
</div>
</aside>
<main class="content">
<div class="breadcrumb">
<a href="../index.html">Главная</a> &raquo; {{ current_topic.title }}
</div>
<div class="topic-header">
<h2>{{ current_topic.icon_emoji | default('') }} {{ current_topic.title }}</h2>
</div>
<div class="info-panel">
<p>Всего сообщений: {{ current_topic.total_messages }} | Первое сообщение: {{ current_topic.first_message_time }} | Последнее: {{ current_topic.last_message_time }}</p>
</div>
<div class="topic-toolbar">
<div class="order-label">
Показ: {% if show_order_label %}от новых к старым{% else %}от старых к новым{% endif %}
</div>

{% if total_pages > 1 and config.ui.get('show_top_pagination', false) %}
<div class="pagination top-pagination">
{% if current_page > 1 %}
<a href="topic_{{ current_topic.id }}_page_{{ current_page - 1 }}.html">&laquo; Назад</a>
{% endif %}
{% for page_num in page_links %}
{% if page_num == current_page %}
<span class="current">{{ page_num }}</span>
{% else %}
<a href="topic_{{ current_topic.id }}_page_{{ page_num }}.html">{{ page_num }}</a>
{% endif %}
{% endfor %}
{% if current_page < total_pages %}
<a href="topic_{{ current_topic.id }}_page_{{ current_page + 1 }}.html">Вперёд &raquo;</a>
{% endif %}
</div>
{% endif %}
</div>

<div class="messages-list">
{% for group in message_groups %}
{% if group.is_album %}
{% set lead = group.messages[0] %}
<div class="message-card layout-{{ message_layout }}" id="m{{ lead.id }}">
{{ card_header(lead, config, default_avatar) }}
<div class="message-body">
<div class="message-main">
{% for m in group.messages if m.media_skipped_size_human %}
<div class="media-skipped">Вложение не сохранено — {{ m.media_skipped_size_human }}: превышает лимит архива.</div>
{% endfor %}
{% for m in group.messages if m.text %}
<div class="message-text">{{ m.text | safe }}</div>
{% endfor %}
</div>
<div class="album-grid">
{% for m in group.messages %}{{ album_media(m) }}{% endfor %}
</div>
</div>
</div>
{% else %}
{% set message = group.messages[0] %}
<div class="message-card layout-{{ message_layout }}" id="m{{ message.id }}">
{{ card_header(message, config, default_avatar) }}
<div class="message-body">
<div class="message-main">
{% if message.media_skipped_size_human %}
<div class="media-skipped">
Вложение не сохранено — {{ message.media_skipped_size_human }}{% if message.file_extension %} ({{ message.file_extension | upper }}){% endif %}: превышает лимит архива.
</div>
{% endif %}
{% if message.text %}
<div class="message-text">{{ message.text | safe }}</div>
{% endif %}
</div>
{% if message.media_thumbnail_path or (message.media_original_path and message.media_type != 'photo') %}
<div class="message-media">
{% if message.media_type == 'photo' %}
<a class="media-photo" href="../{{ message.media_original_path }}" target="_blank">
<img src="../{{ message.media_thumbnail_path }}" alt="Фото" loading="lazy">
</a>
{% elif message.media_type == 'video' %}
<video controls preload="none"><source src="../{{ message.media_original_path }}" type="video/mp4">Видео не поддерживается.</video>
{% else %}
<a href="../{{ message.media_original_path }}" target="_blank" download>
Файл: {{ message.media_original_path.split('/')[-1] }}{% if message.file_extension %} ({{ message.file_extension | upper }}){% endif %}
</a>
{% endif %}
<div class="file-size">{% if message.thumb_size_human %}превью {{ message.thumb_size_human }}{% endif %}{% if message.thumb_size_human and message.file_size_human %} · {% endif %}{% if message.file_size_human %}оригинал {{ message.file_size_human }}{% endif %}</div>
</div>
{% endif %}
</div>
</div>
{% endif %}
{% endfor %}
</div>
</main>
</div>

{% if total_pages > 1 %}
<div class="bottom-bar">
<div class="pagination">
{% if current_page > 1 %}
<a href="topic_{{ current_topic.id }}_page_{{ current_page - 1 }}.html">&laquo; Назад</a>
{% endif %}
{% for page_num in page_links %}
{% if page_num == current_page %}
<span class="current">{{ page_num }}</span>
{% else %}
<a href="topic_{{ current_topic.id }}_page_{{ page_num }}.html">{{ page_num }}</a>
{% endif %}
{% endfor %}
{% if current_page < total_pages %}
<a href="topic_{{ current_topic.id }}_page_{{ current_page + 1 }}.html">Вперёд &raquo;</a>
{% endif %}
</div>
</div>
{% endif %}

<footer class="footer">
<p class="footer-line">{{ site_title }}{% if show_update_time %} · обновлено {{ generation_date }} UTC{% endif %} · сообщений: {{ current_topic.total_messages }}{% if footer_text %} · {{ footer_text }}{% endif %}</p>
</footer>
</body>
</html>
