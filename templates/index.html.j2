<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site_title }}</title>
<link rel="stylesheet" href="static/css/style.css">
</head>
<body data-theme="{{ default_theme }}">
<header class="header">
    <div class="header-title-desc">
        <h1>{{ site_title }}</h1>
        <p>{{ site_description }}</p>
    </div>
    <form class="search-box" action="{{ config.get('search', {}).get('url', '/search') }}" method="get">
        <input type="text" name="q" class="search-input" placeholder="Поиск по архиву..." autocomplete="off" required>
        <button type="submit" class="search-button">Найти</button>
    </form>
</header>

{% if ticker_enabled %}
<div class="ticker">
<div class="ticker-content">
{% for text in ticker_texts %}
<span class="ticker-item">{{ text }}</span>
&nbsp; &nbsp; &nbsp;
{% endfor %}
</div>
</div>
{% endif %}
<div class="main-content">
<aside class="sidebar">
<div class="sidebar-section">
<h3>Все Темы</h3>
<ul class="topic-list">
{% for topic in topics %}
<li>
<a href="{{ topic.first_page_filename }}">
{{ topic.icon_emoji | default('') }} {{ topic.title }}
<span class="count">({{ topic.message_count }})</span>
</a>
</li>
{% endfor %}
</ul>
</div>
<div class="sidebar-section">
<h3>{{ config.get('ui', {}).get('useful_links_title', 'Полезные ссылки') }}</h3>
<ul class="useful-links">
{% for link in useful_links %}
<li>
<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
{{ link.icon | default('🔗') }} {{ link.name }}
{% if link.description %}<br><small>{{ link.description }}</small>{% endif %}
</a>
</li>
{% endfor %}
</ul>
</div>
</aside>
<main class="content">
{% if config.site.welcome_text %}
<div class="welcome-block">
{{ config.site.welcome_text | replace('\n', '<br>') | safe }}
</div>
{% endif %}
<div class="stats-block">
<h3>Статистика архива</h3>
<p>Всего сообщений: {{ total_messages }}</p>
<p>Всего тем: {{ total_topics }}</p>
<p>Самая активная тема: {{ most_active_topic }}</p>
<p>Версия генерации (запуск #{{ generation_run_number }})</p>
</div>
</main>
</div>
<footer class="footer">
<p>{{ site_title }} | Обновлено: {{ generation_date }} | Запуск #{{ generation_run_number }} | Сообщений: {{ total_messages }}</p>
{% if footer_text %}<p>{{ footer_text }}</p>{% endif %}
</footer>
</body>
</html>
